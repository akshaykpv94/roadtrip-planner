# Maps provider. Default is "osm": OpenStreetMap (Nominatim + OSRM + Overpass). No API key, no billing.
# Use "mock" for tests and offline development (clearly labelled sample data, never real routes).
MAPS_PROVIDER=osm

# The OpenStreetMap services ask clients to identify themselves. Put an email address or a URL here.
OSM_CONTACT=

# Optional: use your own instances instead of the free public ones (recommended beyond personal use).
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# OSRM_URL=https://router.project-osrm.org/route/v1/driving/
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Set to true only if your own OSRM supports exclude=toll (the public demo server does not).
# OSRM_EXCLUDE_TOLL=false

PORT=8080
RATE_LIMIT_PER_MINUTE=20

# Saved trips (Supabase). Anon/public key only; never a service-role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=
